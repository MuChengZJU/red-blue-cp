# Red Blue CP 配置
# 复制此文件为 .env 并填入实际值

# ── 必填（共享 Key）────────────────────────────────────────────
# 千问AI平台（原百炼 DashScope）的 API Key，三个能力默认共用。
# 获取：https://platform.qianwenai.com/home/api-keys
DASHSCOPE_API_KEY=sk-your-api-key-here

# ── 模型服务商（0.7：ASR / VLM / LLM 可分别自定义）──────────────
# 全部走千问AI平台 cn-beijing 区域端点：
#   ASR  https://cn-beijing.maas.qianwenaiapi.com/api/v1
#   VLM/LLM  https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
#
# 默认性价比组合（2026-10-21 按官方价格表核算）：
#   ASR  paraformer-v2       0.288 元/小时，支持说话人分离
#   VLM  qwen3.7-flash       0.2/0.8 元每百万 token（≤32K），图片/视频+结构化输出
#   LLM  qwen3.7-flash       同上，1M 上下文
# 两者默认关闭思考模式；不关的话 qwen3.7/3.8-flash 会默认思考，短文本也会
# 烧上千 output token（实测）。要更强效果可换 qwen3.8-flash / qwen-plus。
#
# ASR 仍使用 DashScope 原生异步转写协议（上传→提交→轮询）；VLM/LLM 使用
# OpenAI 兼容 /chat/completions，因此 VLM/LLM 可指向任意兼容服务商。
#
# 各能力的 *_API_KEY 留空 → 回退 DASHSCOPE_API_KEY。
# VLM 的 base_url / api_key 留空 → 继承 LLM。

# 第三方 OpenAI 兼容服务示例（OpenRouter / DeepSeek / Gemini 兼容层 / 自建网关）
# RBCP_VLM_BASE_URL=https://openrouter.ai/api/v1
# RBCP_VLM_API_KEY=sk-or-v1-...
# RBCP_VLM_MODEL=google/gemini-3.1-flash
# RBCP_LLM_BASE_URL=https://api.deepseek.com/v1
# RBCP_LLM_API_KEY=sk-...
# RBCP_LLM_MODEL=deepseek-chat

# ASR 模型（默认 paraformer-v2，可选 qwen3-asr-flash-filetrans / fun-asr）
# RBCP_ASR_MODEL=paraformer-v2

# 说话人分离（默认开；多人对谈正文标注「说话人N：」，单人自动降级纯文本）
# RBCP_ASR_DIARIZATION=true

# 说话人数量提示（整数 2-100，不填自动判断；填了也只是辅助算法尽量输出该人数）
# RBCP_ASR_SPEAKER_COUNT=

# VLM 模型（默认 qwen3.7-flash；更强可换 qwen3.8-flash）
# RBCP_VLM_MODEL=qwen3.7-flash

# VLM 思考模式（默认 false；开=更慢更贵，复杂图表/长视频再开）
# RBCP_VLM_THINKING=false

# VLM 图片传法：auto（默认）/ url / base64
# auto：千问/百炼传 URL，第三方服务商先下载转 base64；取图失败自动回退一次
# RBCP_VLM_IMAGE_MODE=auto

# LLM 文本清洗 / 速览模型（默认 qwen3.7-flash；更稳可换 qwen-plus / qwen3.8-flash）
# RBCP_LLM_MODEL=qwen3.7-flash

# LLM 思考模式（默认 false；速览质量不够时再开，会显著增加输出 token 和耗时）
# RBCP_LLM_THINKING=false

# ── 其他可选 ──────────────────────────────────────────────────
# 小红书 cookie。单篇公开笔记的"正文转录"不需要；
# 「带评论」「博主全量/批量」需要（这两个走浏览器代签，要登录态）。
# 来源二选一：
#   1) XHS_COOKIE：原始 cookie 串（从浏览器开发者工具复制），生产首选
# XHS_COOKIE=web_session=...; a1=...
#   2) RBCP_XHS_COOKIE_FILE：指向 cookie JSON 文件（Playwright/CDP 导出格式，
#      {"cookies":[...]} 或裸数组皆可）。dev/自动化用；XHS_COOKIE 存在时优先用它。
# RBCP_XHS_COOKIE_FILE=

# Markdown 输出目录（默认 ~/transcript）
# RBCP_OUTPUT_DIR=~/transcript

# 原始媒体落盘目录（仅 --save-media 时用；独立于知识库，默认 ~/transcript-media）
# RBCP_MEDIA_DIR=~/transcript-media

# 博主全量抓取调参（一般不用动）
# RBCP_DISCOVER_SCROLL_WAIT=2.2   # 每次滚动后等待秒数
# RBCP_DISCOVER_MAX_PAGES=80      # 安全上限，防失控翻页

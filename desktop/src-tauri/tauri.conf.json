{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RBCP Desktop",
  "version": "0.1.0",
  "identifier": "org.redbluecp.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Red Blue CP",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/rbcp-serve"]
  },
  "plugins": {}
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "前端可调 run_digest（间接 spawn sidecar）；shell:allow-execute 限定 rbcp-sidecar。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/rbcp-sidecar",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
